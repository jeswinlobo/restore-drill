+// A legacy export can omit a collection id while its links still carry it.
+// Reject an ambiguous hierarchy before creating any destination records.
+function archiveHierarchy(collections: Backup["collections"]) {
+  const parentById = new Map<number, number | null>();
+  const ids = collections.map((collection) => {
+    const hints = new Set([collection.id, ...collection.links.map(link => link.collectionId)]
+      .filter(id => id != null));
+    const id: number | undefined = Array.from(hints)[0];
+    if (hints.size > 1 || (id != null && (!Number.isSafeInteger(id) || parentById.has(id)))) {
+      throw new Error("Conflicting collection identifiers.");
+    }
+    if (id != null) parentById.set(id, collection.parentId ?? null);
+    return id;
+  });
+  const resolved = new Set<number>();
+  for (const collection of collections) {
+    const visited = new Set<number>();
+    let id = collection.parentId;
+    while (id != null && !resolved.has(id)) {
+      if (!parentById.has(id) || visited.has(id)) throw new Error("Unknown or cyclic collection parent.");
+      visited.add(id);
+      id = parentById.get(id) ?? null;
+    }
+    visited.forEach(key => resolved.add(key));
+  }
+  return ids;
+}
